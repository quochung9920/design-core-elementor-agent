# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Database -----------------------------------------------------------
DB_NAME=design_core
DB_USER=design_core
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- WordPress ------------------------------------------------------------
WP_IMAGE=wordpress:php8.3-apache
WPCLI_IMAGE=wordpress:cli-php8.3
WP_PORT=8080
WP_ENVIRONMENT_TYPE=local

# --- Design Core MCP Bridge -------------------------------------------------
MCP_PORT=3000

# Create this AFTER `docker compose up -d` and installing/activating Elementor +
# this plugin: wp-admin -> Design Core -> Remote Access -> Machine Credentials ->
# Create Credential. The plain token is shown exactly once -- paste it here, then
# `docker compose up -d design-core-mcp` to pick it up.
DESIGN_CORE_SITE_LOCAL_TOKEN=

# Only ever needed if this site's plugin also talks to Figma directly
# (server-side, e.g. `wp design-core figma_url ...`) -- the MCP bridge itself
# never touches Figma or this token; Design_Core_Elementor_Figma_Transport does.
# DESIGN_CORE_FIGMA_ACCESS_TOKEN=

# --- Inbound MCP authentication ---------------------------------------------
# Authenticates a CALLER to the /mcp endpoint -- the opposite direction from, and a
# completely different secret than, DESIGN_CORE_SITE_LOCAL_TOKEN above (which authenticates
# the bridge TO WordPress). Never reuse one for the other. "token" is required for any
# deployment reachable from outside this machine; the server refuses to start in token mode
# with an empty token rather than silently falling back to unauthenticated access.
MCP_INBOUND_AUTH_MODE=token
# Generate locally, e.g.: openssl rand -base64 48
# Never commit the real value -- this line intentionally has no default here.
MCP_INBOUND_TOKEN=

# MCP_INBOUND_AUTH_MODE=none is NOT a public/deployment mode -- it is refused at startup
# unless BOTH of these are also true: MCP_ALLOW_INSECURE_LOCAL_AUTH=1 is set here, AND the
# server's own HOST binds a loopback address it can prove (127.0.0.1, ::1, or localhost only
# -- not a hostname that merely happens to resolve there). This Compose stack's design-core-mcp
# service hardcodes HOST=0.0.0.0 (see docker-compose.yml) and is therefore structurally unable
# to use "none" mode at all, regardless of this variable -- it is DIRECT HOST LOOPBACK
# DEVELOPMENT ONLY, for running mcp-server's compiled server.js yourself (`node
# dist/src/server.js`, no Docker) on your own machine. Never add this to the Compose service.
# MCP_ALLOW_INSECURE_LOCAL_AUTH=1

# --- Public HTTPS gateway (Caddy) -------------------------------------------
# The public hostname for the /mcp endpoint -- see deploy/caddy/Caddyfile and
# docs/mcp-public-router.md. Needs a public DNS A record pointing at this host's public
# IPv4, and a router NAT rule forwarding WAN TCP 443 (and 80, for ACME) to this host. Caddy
# then obtains and renews a real public TLS certificate automatically; nothing else in this
# stack is ever exposed publicly (design-core-mcp:3000, WordPress, MySQL all stay private).
# This is only a placeholder -- replace with your own domain, never commit a real one here.
MCP_PUBLIC_HOST=mcp.example.com
