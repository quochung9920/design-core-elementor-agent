# HTTPS reverse proxy for the public MCP endpoint:
#
#   Internet -> router TCP 443 -> this Caddy container -> design-core-mcp:3000 (private
#   Docker network only, never published to 0.0.0.0)
#
# {$MCP_PUBLIC_HOST} is read from the `caddy` service's own environment (docker-compose.yml),
# which in turn comes from MCP_PUBLIC_HOST in .env -- never hardcode a real hostname here.
#
# Caddy's automatic HTTPS is intentionally left to its zero-config default: for any real
# hostname (not "localhost"/an IP), it obtains and renews a real public certificate via ACME
# (Let's Encrypt) using the HTTP-01 challenge on port 80, and auto-redirects HTTP -> HTTPS.
# That requires MCP_PUBLIC_HOST to already resolve (public DNS A record) to this host's public
# IP and port 80/443 to actually reach this container -- see docs/mcp-public-router.md for the
# router/DNS steps this repository cannot perform on its own.
{$MCP_PUBLIC_HOST} {
	# Only these two paths are ever routed to the bridge -- everything else, including the
	# detailed/auth-protected GET /health, is intentionally unreachable from the public
	# internet (internal-only: docker compose exec, or curl from inside this Docker network).
	handle /mcp {
		# reverse_proxy passes through all incoming headers, Authorization included, by
		# default -- this is only here to document that explicitly and guard against a
		# future edit accidentally stripping it (e.g. via `header_up -Authorization`).
		reverse_proxy design-core-mcp:3000
	}

	handle /healthz {
		reverse_proxy design-core-mcp:3000
	}

	handle {
		respond 404
	}
}
