# Optional dedicated public API hostname for ChatGPT GPT Actions.
# Merge this block into the shared Caddy instance that owns :80/:443.
#
# Required Caddy environment values:
#   DESIGN_CORE_API_PUBLIC_HOST=api.designcorehub.online
#   DESIGN_CORE_API_UPSTREAM=design-core-staging-wordpress:80
#
# Recommended WordPress/PHP constant:
#   define('DESIGN_CORE_API_PUBLIC_URL', 'https://api.designcorehub.online/v1');
#
# External /v1/* is rewritten to WordPress's always-available rest_route form. This keeps
# the API stable even when the upstream Apache installation has broken pretty /wp-json rules.
{$DESIGN_CORE_API_PUBLIC_HOST} {
	@owner_api path_regexp owner_api ^/v1(?P<route>/.*)$
	handle @owner_api {
		rewrite * /?rest_route=/design-core/v1{re.owner_api.route}
		reverse_proxy {$DESIGN_CORE_API_UPSTREAM}
	}

	handle {
		respond 404
	}
}
