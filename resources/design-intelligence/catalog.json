  "ux_rules": [
    {"id":"uuxpm-reduced-motion","category":"Accessibility","severity":"high","check":"browser-reduced-motion","guidance":"Respect prefers-reduced-motion and keep a readable static final state when motion is reduced."},
    {"id":"uuxpm-focus-not-obscured","category":"Accessibility","severity":"high","check":"browser-focus","guidance":"Sticky UI and overlays must not fully cover the keyboard-focused control."},
    {"id":"uuxpm-focus-appearance","category":"Accessibility","severity":"medium","check":"browser-focus","guidance":"Keep focus indicators visible with sufficient area and state contrast; do not remove focus rings without an equivalent."},
    {"id":"uuxpm-target-size","category":"Accessibility","severity":"high","check":"browser-touch-target","guidance":"Use adequately sized pointer targets and spacing; verify web target-size exceptions rather than assuming native mobile guidance."},
    {"id":"uuxpm-drag-alternative","category":"Accessibility","severity":"high","check":"interaction","guidance":"When drag is author-controlled, provide a single-pointer and keyboard alternative."},
    {"id":"uuxpm-image-alt","category":"Accessibility","severity":"high","check":"elementor-image-alt","guidance":"Meaningful images need useful alternative text; decorative imagery should be intentionally marked decorative."},
    {"id":"uuxpm-control-name","category":"Accessibility","severity":"high","check":"elementor-control-name","guidance":"Interactive controls need an accessible name; icon-only controls require an explicit label."},
    {"id":"uuxpm-heading-hierarchy","category":"Typography","severity":"medium","check":"elementor-heading-order","guidance":"Keep heading hierarchy meaningful and avoid unexplained level jumps."},
    {"id":"uuxpm-long-token-wrap","category":"Layout","severity":"high","check":"browser-overflow","guidance":"Long URLs, identifiers and user content must not force horizontal overflow."},
    {"id":"uuxpm-autoplay-media","category":"Sustainability","severity":"medium","check":"browser-media","guidance":"Prefer user-controlled media, captions and reduced-motion behavior; avoid heavy autoplay loops."},
    {"id":"uuxpm-auto-rotating-controls","category":"Animation","severity":"high","check":"interaction","guidance":"Auto-rotating content needs previous/next and pause controls and should stop for focus, hover and reduced motion."},
    {"id":"uuxpm-hover-vs-tap","category":"Interaction","severity":"high","check":"interaction","guidance":"Do not rely on hover for a primary action; touch and keyboard users need equivalent activation."},
    {"id":"uuxpm-loading-feedback","category":"Interaction","severity":"high","check":"interaction","guidance":"Show understandable feedback during asynchronous operations instead of leaving the interface frozen."},
    {"id":"uuxpm-form-error-summary","category":"Forms","severity":"high","check":"interaction","guidance":"For failed form validation, pair inline errors with a focusable summary that links back to invalid fields when appropriate."},
    {"id":"uuxpm-contrast","category":"Accessibility","severity":"high","check":"browser-contrast","guidance":"Verify text and interactive-state contrast against their actual rendered backgrounds; do not rely on color tokens alone."}
  ]
